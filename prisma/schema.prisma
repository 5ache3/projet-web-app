generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String @id @default(uuid()) // Auto-generated ID
  name        String
  username    String  @unique
  email       String  @unique
  image_url   String?
}

model Projet{
  id String  @id @default(uuid())
  title String
  mamager String
  deadline DateTime
  
}